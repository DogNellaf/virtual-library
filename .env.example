# Copy to .env and adjust. docker compose and manage.py both read it.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=library.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://library.example.com
DJANGO_TIME_ZONE=Europe/Moscow

# Behind a TLS proxy (nginx, Caddy, Traefik) keep HTTPS on and trust X-Forwarded-Proto.
HTTPS=True
USE_X_FORWARDED_PROTO=True

# Without DATABASE_URL a local SQLite file is used. docker compose builds it from DATABASE_PASSWORD.
# DATABASE_URL=postgres://library:password@localhost:5432/library
DATABASE_PASSWORD=change-me

# Total size of all files and the limit for one upload, in bytes. A quota of 0 means no limit.
# The quota is copied into the database on first start and can then be changed in the admin.
STORAGE_QUOTA_BYTES=53687091200
FILE_UPLOAD_MAX_BYTES=536870912

# Superuser created on start if it does not exist. Its password can then be changed in the admin.
ADMIN_USERNAME=librarian
ADMIN_PASSWORD=

# Demo content and a demo account shown on the login page. Turn off in production.
DEMO_SEED=False
DEMO_USERNAME=
DEMO_PASSWORD=

# SECURITY WARNING: don't run with the debug turned on in production!
DEBUG=False

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY='secret-key'

# Database name
DATABASE_NAME='virtual_library'

# Database user
DATABASE_USERNAME='librarian'

# Database password
DATABASE_PASSWORD='PASS YOUR PASSWORD HERE'

# PostgreSQL host
